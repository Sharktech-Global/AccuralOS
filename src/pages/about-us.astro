---
import Layout from '../layouts/Layout.astro';
import '../css/about-us.css';
import Osin from '../components/osin.astro';
import Faq from '../components/Faq.astro';
import Sec from '../components/Aboutsec.astro';
import Thi from '../components/Aboutthi.astro';

---

<Layout
  title="About AccrualOS — Built for the modern practice"
  description="Learn about AccrualOS: the practice-management and automation platform made only for Australian accounting and bookkeeping firms, built within the Sharktech Global group on the VCPility engine."
>

<section class="ah-section">
  <div class="ah-wrap">
    <div class="ah-body">
      <div class="ah-media"></div>
      <div class="ah-fluted"></div>
      <div class="ah-tint"></div>
      <div class="ah-sheen"></div>
      <div class="ah-vignette"></div>

      <span class="ah-brand">AccrualOS</span>
      <h1 class="ah-title"><i>/</i>About Us<i>/</i></h1>
      <nav class="ah-crumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><em>About us</em>
      </nav>
    </div>
  </div>
</section>




<section class="aos-herolt" data-page="about">

 
  <div class="aos-herolt__lattice" aria-hidden="true"></div>
  <div class="aos-herolt__orb" aria-hidden="true"></div>
 
  <div class="aos-herolt__wrap">
    <!-- LEFT -->
    <div class="aos-herolt__copy">
      <span class="aos-herolt__eyebrow" data-reveal>
        <span class="dot" aria-hidden="true"></span> A VCPility platform · built by Sharktech Global
      </span>
 
      <div class="aos-herolt__head" data-reveal style="--d:80ms">
        <span class="aos-herolt__ghost" aria-hidden="true">Accounting practice management and</span>
        <h1 class="aos-herolt__h1">Growth, Built for<br>Modern Practice.</h1>
      </div>
 
      <p class="aos-herolt__sub" data-reveal style="--d:160ms">
        AccrualOS is the practice-management and automation platform made only for
        Australian accounting and bookkeeping firms — one system to run the work,
        clear the admin, and give your team its time back.
      </p>
 
      <div class="aos-herolt__cta" data-reveal style="--d:240ms">
        <a class="aos-herolt__pill" href="/contact-us">
          Start your $1 trial
          <span class="ic" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
          </span>
        </a>
        <a class="aos-herolt__explore" href="/contact-us">
          <span class="aos-herolt__ring" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
          </span>
          Explore AccrualOS
        </a>
      </div>
 
      <div class="aos-herolt__facts" data-reveal style="--d:320ms">
        <span>21-day implementation</span>
        <span>Xero · MYOB · Karbon · Ignition</span>
        <span>Built in Australia</span>
      </div>
    </div>
 
    <!-- RIGHT -->
    <div class="aos-herolt__media" data-reveal style="--d:160ms">
      <div class="aos-herolt__disc">
        <!-- Swap src with your team / practice photo -->
        <img class="aos-herolt__photo" src="/about2.jpg" alt="The team behind AccrualOS" onerror="this.style.display='none'">
      </div>
 
      <div class="aos-herolt__live" aria-label="Live activity">
        <div class="aos-herolt__live-head">
          <b><i></i>Running now</b>
          <span>6:12 am</span>
        </div>
        <div class="aos-herolt__live-evt">
          <span class="ic"><svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M1 5h8M5.5 1.5L9 5l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          <div>
            <div class="t">New enquiry</div>
            <div class="s">"Need help with a company tax return"</div>
          </div>
        </div>
      </div>

      <div class="aos-herolt__live is-dark is-tr" aria-hidden="true">
        <div class="aos-herolt__live-head">
          <b><i></i>Just now</b>
          <span>10:04 am</span>
        </div>
        <div class="aos-herolt__live-evt">
          <span class="ic ic-ok"><svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M1.5 5.2l2.3 2.3L8.5 2.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          <div>
            <div class="t">Replied &amp; qualified</div>
            <div class="s">Meeting booked — Thu 10:00 am</div>
          </div>
        </div>
      </div>

      <div class="aos-herolt__live is-dark is-br" aria-hidden="true">
        <div class="aos-herolt__live-head">
          <b><i></i>Filed</b>
          <span>9:47 am</span>
        </div>
        <div class="aos-herolt__live-evt">
          <span class="ic ic-doc"><svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 1.5h4l2 2v7H3z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><path d="M4.6 6.2h2.8M4.6 8h2" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/></svg></span>
          <div>
            <div class="t">Documents filed</div>
            <div class="s">BAS &amp; payroll — 4 of 4</div>
          </div>
        </div>
      </div>
    </div>
  </div>
 
  <script is:inline>
    (function(){
      var root = document.currentScript.closest('.aos-herolt');
      if(!root) return;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var reveals = root.querySelectorAll('[data-reveal]');
      if('IntersectionObserver' in window && !reduce){
        var io = new IntersectionObserver(function(entries){
          entries.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('is-in'); io.unobserve(e.target); } });
        }, { threshold: 0.15 });
        reveals.forEach(function(el){ io.observe(el); });
      } else { reveals.forEach(function(el){ el.classList.add('is-in'); }); }
      requestAnimationFrame(function(){ root.classList.add('is-ready'); });
    })();
  </script>
</section>
 <Sec />
 <Thi />



</Layout>
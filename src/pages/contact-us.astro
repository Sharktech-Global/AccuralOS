          </a>
          <a href="https://maps.google.com/?q=Level+1,+244+Macquarie+St,+Liverpool+NSW+2170" target="_blank" rel="noopener noreferrer" class="aoscp__row">
            <span class="aoscp__ico">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            </span>
            <span class="aoscp__rowtext"><small>Sydney &middot; Headquarters</small><strong>Level 1, 244 Macquarie St, Liverpool NSW 2170, Australia</strong></span>
            <svg class="aoscp__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a href="https://maps.google.com/?q=Suite+383,+11+Wilson+St,+South+Yarra+VIC+3141" target="_blank" rel="noopener noreferrer" class="aoscp__row">
            <span class="aoscp__ico">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            </span>

<script src="https://ghllinks.sharktech.com.au/js/form_embed.js"></script>
          </div>
          <p class="aoscp__note">By submitting this form you agree to our <a href="/privacy">Privacy Policy</a>. AccrualOS may contact you via email or phone to schedule your consultation.</p>
        </div>
      </div>

    </div>
  </div>
</div>

<script is:inline async src="https://payments.accrualos.com.au/js/form_embed.js"></script>

<script is:inline>
/* Aligns the form's top onto the image band, regardless of title height */
(function(){
  function sync(){
    document.querySelectorAll('.aoscp').forEach(function(root){
      var band=root.querySelector('.aoscp__band');
      var rc=root.querySelector('.aoscp__rc');
      if(!band||!rc) return;
      if(window.matchMedia('(max-width:880px)').matches){ rc.style.marginTop=''; return; }
      var overlap=parseInt(getComputedStyle(root).getPropertyValue('--aoscp-overlap'))||48;
      rc.style.marginTop=(band.offsetTop+overlap)+'px';
    });
  }
  window.addEventListener('load',sync);
  window.addEventListener('resize',sync);
  setTimeout(sync,300); setTimeout(sync,1000);
})();
</script>

<style>
.aoscp{
  --aoscp-navy:#0F2B46;
  --aoscp-coral:#E46E14;
  --aoscp-line:#e2e0dc;
  --aoscp-muted:#7a8794;
  --aoscp-radius:16px;
  --aoscp-band-h:clamp(360px,38vw,530px);
  --aoscp-overlap:48px;                 /* form drop onto the band */
  --aoscp-stick-top:7.5rem;             /* where the left panel pins */
  --aoscp-font-head:'Manrope',system-ui,-apple-system,sans-serif;
  --aoscp-font-body:'Manrope',system-ui,-apple-system,sans-serif;
  font-family:var(--aoscp-font-body);
  background:var(--aoscp-bg);
  padding:clamp(2rem,6vw,4rem) clamp(1rem,4vw,3rem);
  color:var(--aoscp-navy);
}
.aoscp *{box-sizing:border-box;font-family:'Manrope',system-ui,-apple-system,sans-serif;}
.aoscp__inner{max-width:1300px;margin:0 auto;}

.aoscp__zone{
  position:relative;
  display:grid;grid-template-columns:45% 55%;align-items:start;gap:0;
}

/* the block that STAYS */
.aoscp__stay{
  grid-column:1 / 3;grid-row:1;
  position:sticky;top:var(--aoscp-stick-top);z-index:0;align-self:start;
}

.aoscp__pill{
  display:inline-block;font-size:.7rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;
  color:#fff;background:var(--aoscp-navy);padding:.55rem 1rem;border-radius:8px;
}
.aoscp__title{
  font-family:var(--aoscp-font-head);
  font-size:clamp(2rem,4vw,3rem);font-weight:800;line-height:1.08;letter-spacing:-.02em;
  margin:1.1rem 0 1.5rem;max-width: 40vw;
}
.aoscp__title em{font-style:normal;color:var(--aoscp-coral);}

.aoscp__band{
  position:relative;width:100%;height:var(--aoscp-band-h);
  border-radius:var(--aoscp-radius);overflow:hidden;
  box-shadow:0 18px 44px rgba(15,43,70,.16);
}
.aoscp__img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
.aoscp__scrim{
  position:absolute;inset:0;
 background: linear-gradient(to right, #0f2b4682 0%, #0f2b4680 45%, #164857b8 72%);
}
.aoscp__chal{position:absolute;left:0;bottom:0;z-index:2;padding:1.7rem 1.9rem;color:#fff;max-width:33%;}
.aoscp__chal h3{font-family:var(--aoscp-font-head);font-size:1.35rem;font-weight:700;margin:0 0 .5rem;}
.aoscp__chal p{font-size:.9rem;line-height:1.55;margin:0;color:rgba(255,255,255,.88);}

.aoscp__contacts{margin-top:1.4rem;max-width:460px;}
.aoscp__row{
  display:flex;align-items:center;gap:1rem;padding:1rem .25rem;
  border-bottom:1px solid var(--aoscp-line);
  text-decoration:none;color:var(--aoscp-navy);transition:padding-left .2s;
}
.aoscp__row:hover{padding-left:.6rem;}
.aoscp__ico{
  flex:0 0 auto;width:46px;height:46px;border-radius:50%;
  border:1.5px solid var(--aoscp-coral);color:var(--aoscp-coral);
  display:grid;place-items:center;transition:background .2s,color .2s;
}
.aoscp__ico svg{width:20px;height:20px;}
.aoscp__row:hover .aoscp__ico{background:var(--aoscp-coral);color:#fff;}
.aoscp__rowtext{display:flex;flex-direction:column;gap:.2rem;flex:1;min-width:0;}
.aoscp__rowtext small{font-size:.72rem;letter-spacing:.05em;text-transform:uppercase;color:var(--aoscp-muted);}
.aoscp__rowtext strong{font-size:.95rem;font-weight:600;}
.aoscp__arrow{width:22px;height:22px;color:var(--aoscp-coral);flex:0 0 auto;transition:transform .2s;}
.aoscp__row:hover .aoscp__arrow{transform:translateX(4px);}

/* the block that MOVES */
.aoscp__rc{
    grid-column: 2 / 3;
    grid-row: 1;
    z-index: 2;
    margin-top: 50px !important;
    padding-right: 20px;
}
.aoscp__right{
  background:#fff;border-radius:var(--aoscp-radius);overflow:hidden;
  box-shadow: rgba(0, 0, 0, 0.15) 0px 2px 8px;border:1px solid var(--aoscp-line);
}
.aoscp__formhead{
  background:var(--aoscp-navy);color:#fff;padding:1.15rem 1.5rem;
  display:flex;align-items:center;justify-content:space-between;
}
.aoscp__brand{display:flex;align-items:center;gap:.85rem;font-family:var(--aoscp-font-head);}
.aoscp__brand strong{font-size:1.05rem;font-weight:800;letter-spacing:-.01em;}
.aoscp__div{width:1px;height:20px;background:rgba(255,255,255,.28);}
.aoscp__sub{font-size:.9rem;color:rgba(255,255,255,.78);}
.aoscp__plane{width:22px;height:22px;color:var(--aoscp-coral);}
.aoscp__formbody{padding:.5rem;}
.aoscp__formbody iframe{display:block;border-radius:10px;}
.aoscp__note{font-size:.75rem;color:var(--aoscp-muted);line-height:1.5;padding:0 1.5rem 1.4rem;margin:0;}
.aoscp__note a{color:var(--aoscp-coral);text-decoration:none;font-weight:600;}
.aoscp__note a:hover{text-decoration:underline;}

/* MOBILE — no sticky, no overlap; plain stack */
@media (max-width:880px){
  .aoscp__zone{grid-template-columns:1fr;}
  .aoscp__stay{position:static;grid-column:1;grid-row:auto;}
  .aoscp__band{height:280px;}
  .aoscp__scrim{background:linear-gradient(to top,rgba(15,43,70,.92),rgba(15,43,70,.35) 55%,transparent);}
  .aoscp__chal{max-width:100%;}
  .aoscp__contacts{max-width:none;}
  .aoscp__title{max-width:100%;}
  .aoscp__rc{padding-right:0px;}
  .aoscp__rc{grid-column:1;grid-row:auto;margin-top:1.5rem !important;}
}
</style>

</Layout> 
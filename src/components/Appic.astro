<style>
/* ══════════════════════════════════════════════════════════════════════════
   ACCRUALOS · WORKS AROUND YOUR STACK — muted logo strip + right caption
   Light. Left: greyscale logo marquee (colourises on hover). Right: caption.
   Added: faint corporate/accounting background details. Scoped to .cl.
   ══════════════════════════════════════════════════════════════════════════ */
.cl{
  --ink:#0E2E4D;--body:#42506A;--muted:#7B8698;--orange:#E46E14;--teal:#2C7FB5;
  --line:rgba(14,46,77,.10);
  --font:"Manrope",ui-sans-serif,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
  --mono:"Poppins",ui-sans-serif,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
  --ease:cubic-bezier(.22,.85,.3,1);
  position:relative;background:#fff;font-family:var(--font);color:var(--ink);padding-bottom:40px;overflow:hidden;
}
.cl *{box-sizing:border-box}

/* ── background: corporate / accounting details ── */
.cl-bg{position:absolute;inset:0;z-index:0;pointer-events:none;overflow:hidden;}
 
.cl-motif{position:absolute;color:var(--ink);opacity:.07}
.cl-motif svg{width:100%;height:auto;display:block}
.cl-motif.m-ledger{top:-34px;left:-24px;width:clamp(150px,18vw,240px)}
.cl-motif.m-chart{bottom:-40px;right:-26px;width:clamp(180px,22vw,300px)}

.cl-wrap{position:relative;z-index:1;max-width:1260px;margin:0 auto;padding:0 clamp(20px,4vw,40px)}

.cl-strip{display:flex;align-items:center;gap:clamp(28px,4vw,60px);
  opacity:0;transform:translateY(16px);transition:opacity .8s var(--ease),transform .8s var(--ease)}
.cl.in .cl-strip{opacity:1;transform:none}

/* left — muted logo marquee */
.cl-marquee{flex:1 1 auto;min-width:0;overflow:hidden;
  -webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 92%,transparent);
          mask-image:linear-gradient(90deg,transparent,#000 6%,#000 92%,transparent)}
.cl-track{display:flex;align-items:center;width:max-content;animation:clScroll 38s linear infinite}
.cl-marquee:hover .cl-track{animation-play-state:paused}
@keyframes clScroll{to{transform:translateX(-50%)}}
.cl-mitem{display:inline-flex;align-items:center;justify-content:center;padding:0 clamp(28px,2.4vw,42px);}
.cl-mlogo{display:grid;place-items:center;
  transition:filter .35s var(--ease),opacity .35s var(--ease)}
.cl-marquee:hover .cl-mlogo{filter:none;opacity:1}
.cl-mlogo img{max-height:45px;max-width:110px;object-fit:contain;display:block}
.cl-mmark{width:48px;height:48px;border-radius:12px;display:none;place-items:center;background:#EEF2F7;
  color:var(--teal);font-weight:800;font-size:14px;letter-spacing:-.02em}

/* right — caption */
.cl-cap{flex: none;
    width: clamp(180px, 36vw, 430px);
    font-size: clamp(16px, 4vw, 30px);
    font-weight: 800;
    line-height: 1.5;
    color: var(--ink);
    text-transform: capitalize;
    letter-spacing: -.01em;
  }
.cl-cap::before{content:"";display:block;width:118px;height:2px;background:var(--orange);margin-bottom:12px}

@media (max-width:760px){
  .cl-strip{flex-direction:column;gap:24px}
  .cl-cap{width:100%;text-align:center}
  .cl-cap::before{margin:0 auto 12px}
}
@media (prefers-reduced-motion:reduce){
  .cl-strip{opacity:1;transform:none;transition:none}
  .cl-track{animation:none}
}
</style>

<!-- ══════════ WORKS AROUND YOUR STACK (muted strip + caption) — START ══════════ -->

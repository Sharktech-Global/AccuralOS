<script is:inline>
(function () {
  'use strict';
  function init() {
    var section = document.getElementById('pf');
    if (!section) return;
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (e) {
        e.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
      }, { threshold: 0.15 });
      io.observe(section);
    } else { section.classList.add('in'); }

    var tabs = Array.prototype.slice.call(section.querySelectorAll('.pf-tab'));
    var scenes = Array.prototype.slice.call(section.querySelectorAll('.pf-scene'));
    var navItems = Array.prototype.slice.call(section.querySelectorAll('.pf-navi[data-scene]'));
    var subtabs = Array.prototype.slice.call(section.querySelectorAll('.pf-subtabs span'));
    var title = document.getElementById('pfTitle');
    var TITLES = ['Conversations', 'Documents', 'Opportunities', 'Calendars'];

    function play(idx) {
      scenes.forEach(function (sc, i) {
        if (i === idx) { sc.classList.remove('active'); void sc.offsetWidth; sc.classList.add('active'); }
        else sc.classList.remove('active');
      });
      navItems.forEach(function (n) { n.classList.toggle('is-on', parseInt(n.dataset.scene, 10) === idx); });
      title.textContent = TITLES[idx] || '';
    }
    function select(idx) {
      tabs.forEach(function (t, i) { var on = i === idx; t.setAttribute('aria-selected', on ? 'true' : 'false'); t.tabIndex = on ? 0 : -1; });
      play(idx);
    }

    tabs.forEach(function (tab, i) {
      tab.addEventListener('click', function () { select(i); });
      tab.addEventListener('keydown', function (ev) {
        var idx = null;
        if (ev.key === 'ArrowDown' || ev.key === 'ArrowRight') idx = (i + 1) % tabs.length;
        else if (ev.key === 'ArrowUp' || ev.key === 'ArrowLeft') idx = (i - 1 + tabs.length) % tabs.length;
        if (idx !== null) { ev.preventDefault(); tabs[idx].focus(); select(idx); }
      });
    });

    navItems.forEach(function (n) {
      var go = function () { select(parseInt(n.dataset.scene, 10)); };
      n.addEventListener('click', go);
      n.addEventListener('keydown', function (ev) { if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); go(); } });
    });

    subtabs.forEach(function (s) {
      s.addEventListener('click', function () { subtabs.forEach(function (x) { x.classList.remove('on'); }); s.classList.add('on'); });
    });
  }
  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', init); }
  else { init(); }
})();
</script>
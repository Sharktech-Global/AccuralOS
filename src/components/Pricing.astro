<script is:inline>
(function () {
  'use strict';
  function init() {
    var s = document.getElementById('pm'); if (!s) return;

    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (e) { e.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } }); }, { threshold: 0.12 });
      io.observe(s);
    } else { s.classList.add('in'); }

    /* dot pyramid + cascading pulse (delay drives the ripple; animation lives in the global <style>) */
    var svg = document.getElementById('pmPyramid');
    if (svg) {
      var rows = 9, gap = 26, r = 3.5, cx = 130, top = 16, ns = 'http://www.w3.org/2000/svg';
      for (var row = 0; row < rows; row++) {
        var count = row + 1, y = top + row * (gap * 0.74);
        var rowOp = 0.30 + 0.58 * (row / (rows - 1));
        for (var i = 0; i < count; i++) {
          var mid = (count - 1) / 2, x = cx + (i - mid) * gap;
          var c = document.createElementNS(ns, 'circle');
          c.setAttribute('cx', x); c.setAttribute('cy', y); c.setAttribute('r', r);
          var accent = (row >= rows - 3 && Math.abs(i - mid) < 1.6);
          c.setAttribute('fill', accent ? '#38A0DE' : '#FFFFFF');
          c.style.opacity = accent ? '1' : rowOp.toFixed(2);
          c.style.animationDelay = (row * 0.11 + Math.abs(i - mid) * 0.04).toFixed(2) + 's';
          svg.appendChild(c);
        }
      }
    }

    /* slider */
    var track = document.getElementById('pmTrack');
    var cards = Array.prototype.slice.call(track.children);
    var prev = document.getElementById('pmPrev'), next = document.getElementById('pmNext');
    var dotsNav = document.getElementById('pmDotsNav');
    var GAP = 20, index = 0;

    function step() { return cards[0].getBoundingClientRect().width + GAP; }
    function perView() { return Math.max(1, Math.round((track.clientWidth + GAP) / step())); }
    function maxIndex() { return Math.max(0, cards.length - perView()); }

    function buildDots() {
      dotsNav.innerHTML = '';
      for (var i = 0; i <= maxIndex(); i++) {
        var b = document.createElement('button'); b.type = 'button'; b.setAttribute('aria-label', 'Go to slide ' + (i + 1));
        (function (n) { b.addEventListener('click', function () { go(n); }); })(i);
        dotsNav.appendChild(b);
      }
    }
    function sync() {
      track.style.transform = 'translateX(' + (-index * step()) + 'px)';
      Array.prototype.slice.call(dotsNav.children).forEach(function (d, i) { d.classList.toggle('on', i === index); });
      if (prev) prev.disabled = index <= 0;
      if (next) next.disabled = index >= maxIndex();
    }
    function go(i) { index = Math.min(Math.max(i, 0), maxIndex()); sync(); }

    if (next) next.addEventListener('click', function () { go(index + 1); });
    if (prev) prev.addEventListener('click', function () { go(index - 1); });

    var down = false, startX = 0, startTf = 0;
    function px(e) { return e.touches ? e.touches[0].clientX : e.clientX; }
    track.addEventListener('mousedown', ds); track.addEventListener('touchstart', ds, { passive: true });
    function ds(e) { down = true; startX = px(e); startTf = -index * step(); track.classList.add('drag'); }
    window.addEventListener('mousemove', dm); window.addEventListener('touchmove', dm, { passive: true });
    function dm(e) { if (!down) return; track.style.transform = 'translateX(' + (startTf + (px(e) - startX)) + 'px)'; }
    window.addEventListener('mouseup', du); window.addEventListener('touchend', du);
    function du(e) {
      if (!down) return; down = false; track.classList.remove('drag');
      var dx = (e.changedTouches ? e.changedTouches[0].clientX : e.clientX) - startX;
      if (Math.abs(dx) > 45) go(index + (dx < 0 ? 1 : -1)); else sync();
    }

    function rebuild() { index = Math.min(index, maxIndex()); buildDots(); sync(); }
    rebuild();
    var t; window.addEventListener('resize', function () { clearTimeout(t); t = setTimeout(rebuild, 150); });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
})();
</script>
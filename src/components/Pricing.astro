<style>
/* ══════════════════════════════════════════════════════════════════════════
   ACCRUALOS · 05 PLATFORM MODULES — dark cards, enriched. Scoped block.
   ══════════════════════════════════════════════════════════════════════════ */
.pm{
  --ink:#0E2E4D;--body:#42506A;--muted:#7B8698;
  --navy:#0E2E4D;--navy-2:#0B1E33;--orange:#E46E14;--orange-2:#F58A4B;--teal:#38A0DE;
  --line:rgba(14,46,77,.12);--navy-soft:#EAF0F6;
  --gap:20px;--r:8px;
  --font:"Manrope",ui-sans-serif,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
  --mono:"Poppins",ui-sans-serif,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
  --ease:cubic-bezier(.22,.85,.3,1);
  background:#fff;font-family:var(--font);color:var(--ink);padding:clamp(48px,4vw,48px) 0;
}
.pm *{box-sizing:border-box}
.pm-wrap{max-width:1260px;margin:0 auto;}

/* ── dark hero band ── */
.pm-hero{position:relative;overflow:hidden;border-radius:18px;
  background:linear-gradient(122deg,#123457 0%,#0C2140 48%,#0A1B30 100%);
  border:1px solid rgba(255,255,255,.09);
  box-shadow:0 34px 80px rgba(11,30,51,.30), inset 0 1px 0 rgba(255,255,255,.10);
  min-height:clamp(230px,28vw,400px);display:flex;align-items:center;padding:clamp(30px,4vw,50px);
  opacity:0;transform:translateY(20px);transition:opacity .8s var(--ease),transform .8s var(--ease)}
.pm.in .pm-hero{opacity:1;transform:none}
.pm-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
.pm-hero::after{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;
  background:linear-gradient(100deg,rgba(10,27,48,.92) 0%,rgba(10,27,48,.66) 54%,rgba(10,27,48,.30) 100%)}
.pm-hero::before{content:"";position:absolute;inset:0;z-index:2;pointer-events:none;
  background:
    radial-gradient(50% 116% at 86% 14%, rgba(56,160,222,.26), transparent 58%),
    radial-gradient(46% 120% at 3% 98%, rgba(228,110,20,.16), transparent 60%),
    radial-gradient(120% 140% at 50% -20%, rgba(255,255,255,.05), transparent 55%)}

.pm-dots{position:absolute;right:clamp(20px,4.4vw,70px);top:50%;transform:translateY(-50%);z-index:3;
  width:clamp(180px,28vw,380px);pointer-events:none;
  filter:drop-shadow(0 0 22px rgba(56,160,222,.22));animation:pmFloat 7.5s ease-in-out infinite}
@keyframes pmFloat{0%,100%{transform:translateY(-50%)}50%{transform:translateY(calc(-50% - 7px))}}

.pm-hero-c{position:relative;z-index:4;max-width:690px}
.pm-eyebrow{display:inline-flex;align-items:center;gap:10px;font-family:var(--mono);font-size:11.5px;font-weight:600;
  letter-spacing:.24em;text-transform:uppercase;color:var(--orange-2);margin-bottom:clamp(16px,2vw,22px)}
.pm-eyebrow::before{content:"";width:28px;height:2px;background:var(--orange)}
.pm-hero-c h2{margin:0;color:#fff;font-size:clamp(25px,3.6vw,46px);font-weight:700;line-height:1.1;
  letter-spacing:-.03em;text-shadow:0 2px 24px #040c1859;text-transform:capitalize}

/* ── slider ── */
.pm-slider{margin-top:clamp(30px,3.4vw,48px);
  opacity:0;transform:translateY(20px);transition:opacity .8s var(--ease) .12s,transform .8s var(--ease) .12s}
.pm.in .pm-slider{opacity:1;transform:none}
.pm-ctrls{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:18px;padding:20px;}
.pm-ctrls .lab{font-family:var(--mono);font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.pm-arrows{display:flex;gap:8px}
.pm-arrows button{width:40px;height:40px;border-radius:50%;border:1px solid var(--line);background:#fff;color:var(--ink);
  display:grid;place-items:center;cursor:pointer;transition:background .2s,border-color .2s,color .2s,opacity .2s}
.pm-arrows button:hover:not(:disabled){background:var(--navy);border-color:var(--navy);color:#fff}
.pm-arrows button:disabled{opacity:.34;cursor:default}
.pm-arrows svg{width:15px;height:15px}

.pm-viewport{overflow:hidden;padding:28px 16px 36px}
.pm-track{display:flex;gap:var(--gap);transition:transform .55s var(--ease);cursor:grab;touch-action:pan-y}
.pm-track.drag{cursor:grabbing;transition:none}

/* ── ENRICHED DARK CARDS ── */
.pm-card{flex:0 0 calc((100% - 2*var(--gap))/3);min-width:0;
  background:linear-gradient(160deg,#12345A 0%,#0C2140 100%);
  border:1px solid rgba(255,255,255,.10);border-radius:14px;
  box-shadow:0 12px 30px -18px rgba(6,16,30,.55), inset 0 1px 0 rgba(255,255,255,.06);
  padding:24px 22px 22px;position:relative;overflow:hidden;
  transition:transform .3s var(--ease),box-shadow .3s var(--ease),border-color .3s var(--ease)}
/* gradient top accent bar (reveals on hover) */
.pm-card::before{content:"";position:absolute;left:22px;right:22px;top:0;height:2px;
  background:linear-gradient(90deg,var(--orange),var(--orange-2));
  transform:scaleX(0);transform-origin:left;transition:transform .35s var(--ease)}
/* soft corner glow */
.pm-card::after{content:"";position:absolute;top:-42%;right:-32%;width:72%;height:92%;pointer-events:none;
  background:radial-gradient(closest-side, rgba(56,160,222,.22), transparent 70%);
  opacity:.45;transition:opacity .35s var(--ease)}
.pm-card:hover{transform:translateY(-6px);
  box-shadow:0 26px 46px -20px rgba(6,16,30,.62), inset 0 1px 0 rgba(255,255,255,.12);
  border-color:rgba(255,255,255,.22)}
.pm-card:hover::before{transform:scaleX(1)}
.pm-card:hover::after{opacity:1}

/* ghost number */
.pm-no{position:absolute;top:8px;right:16px;z-index:0;font-weight:800;font-size:54px;line-height:1;
  letter-spacing:-.04em;color:rgba(255,255,255,.06);pointer-events:none;user-select:none}

.pm-ic{position:relative;z-index:1;width:48px;height:48px;border-radius:12px;display:grid;place-items:center;
  background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);color:#fff;margin-bottom:16px;
  transition:background .3s var(--ease),color .3s var(--ease),border-color .3s var(--ease),transform .3s var(--ease)}
.pm-card:hover .pm-ic{background:linear-gradient(135deg,var(--orange-2),var(--orange));border-color:transparent;color:#fff;transform:scale(1.06) rotate(-3deg)}
.pm-ic svg{width:24px;height:24px}

.pm-kicker{position:relative;z-index:1;display:block;font-family:var(--mono);font-size:10.5px;font-weight:600;
  letter-spacing:.2em;text-transform:uppercase;color:var(--orange-2);margin-bottom:7px}
.pm-card h3{position:relative;z-index:1;margin:0 0 8px;font-size:19px;font-weight:600;letter-spacing:-.01em;color:#fff}
.pm-card p{position:relative;z-index:1;margin:0;font-size:14.5px;line-height:1.55;color:rgba(255,255,255,.66)}

/* footer: hairline + arrow chip */
.pm-foot{position:relative;z-index:1;display:flex;align-items:center;gap:14px;margin-top:20px}
.pm-line{flex:1;height:1px;background:rgba(255,255,255,.12)}
.pm-go{flex:0 0 auto;width:30px;height:30px;border-radius:50%;display:grid;place-items:center;
  border:1px solid rgba(255,255,255,.18);color:rgba(255,255,255,.7);
  transition:background .3s var(--ease),border-color .3s var(--ease),color .3s var(--ease),transform .3s var(--ease)}
.pm-go svg{width:13px;height:13px}
.pm-card:hover .pm-go{background:var(--orange);border-color:var(--orange);color:#fff;transform:translateX(2px)}

.pm-dotsnav{display:flex;justify-content:center;gap:8px;margin-top:12px}
.pm-dotsnav button{width:8px;height:8px;border-radius:50%;border:0;background:var(--line);cursor:pointer;padding:0;transition:width .25s var(--ease),background .25s var(--ease)}
.pm-dotsnav button.on{width:24px;border-radius:5px;background:var(--orange)}

@media (max-width:760px){.pm-card{flex-basis:calc((100% - var(--gap))/2)}.pm-dots{opacity:.45}}
@media (max-width:520px){.pm-card{flex-basis:100%}.pm-ctrls .lab{display:none}.pm-ctrls{justify-content:flex-end}}
@media (prefers-reduced-motion:reduce){
  .pm-hero,.pm-slider{opacity:1;transform:none;transition:none}
  .pm-track{transition:none}.pm-dots{animation:none}
}
</style>

<!-- GLOBAL block: styles JS-injected SVG dots (Astro won't scope these, so they must be global) -->
<style is:global>
  .pm-dots svg{width:100%;height:auto;display:block;overflow:visible}
  .pm-dots svg circle{transform-box:fill-box;transform-origin:center;
    animation:pmPulse 4.8s cubic-bezier(.22,.85,.3,1) infinite}
  @keyframes pmPulse{
    0%  {transform:scale(1);   filter:drop-shadow(0 0 0 rgba(56,160,222,0))}
    8%  {opacity:1;transform:scale(1.85); filter:drop-shadow(0 0 8px rgba(56,160,222,.9))}
    22% {transform:scale(1);   filter:drop-shadow(0 0 0 rgba(56,160,222,0))}
    100%{transform:scale(1);   filter:drop-shadow(0 0 0 rgba(56,160,222,0))}
  }
  @media (prefers-reduced-motion:reduce){
    .pm-dots svg circle{animation:none;opacity:1!important}
  }
</style>

<!-- ══════════ 05 PLATFORM MODULES — START ══════════ -->

<style>
  .tf{
    --bg:#0e1621;
    --tk-base:#0e1621;
    --tk-wash-1:rgba(44,127,181,.22);
    --tk-wash-2:rgba(239,106,52,.14);
    --line:rgba(255,255,255,.10);
    --text:#e8ecf1;
    --muted:#8b95a3;
    --faint:#63707f;
    --accent:#F0742C;
    --green:#35c07a;
    --r:5px;
    --font:"Manrope";
    position:relative;overflow:hidden;color:var(--text);
    background: radial-gradient(46% 62% at 12% 44%, var(--tk-wash-1), transparent 68%), radial-gradient(38% 50% at 2% 84%, var(--tk-wash-2), transparent 70%), var(--tk-base);
    font-family:var(--font);line-height:1.5;-webkit-font-smoothing:antialiased;font-synthesis-weight:none;
  }
  .tf *{box-sizing:border-box;font-family:var(--font);min-width:0}
  .tf-shell{    position: relative;
    z-index: 1;
    max-width: 1250px;
    margin: 0 auto;
    padding: clamp(40px, 6vw, 62px) clamp(20px, 3vw, 20px) 20px !important;}

  .tf-eyebrow{display:inline-flex;align-items:center;gap:11px;font-size:10px;font-weight:700;
    letter-spacing:.22em;text-transform:uppercase;color:var(--faint)}
  .tf-eyebrow::before{content:"";width:26px;height:1.5px;background:var(--faint)}

  /* ── TOP ── */
  .tf-top{    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    padding-bottom: clamp(10px, 2.4vw, 20px) !important;}
  .tf-brand{display:flex;flex-direction:column;gap:16px}
  .tf-logos{display:flex;align-items:center;gap:clamp(16px,2.6vw,30px);flex-wrap:wrap}
  .tf-logolink{display:inline-flex;align-items:center;transition:opacity .2s ease,transform .2s ease}
  .tf-logolink:hover{opacity:.82;transform:translateY(-1px)}
  .tf-logo{display:block;height:clamp(72px,6.43vw,80px);width:auto;max-width:100%}
  .tf-logo--sm{height:clamp(44px,4.6vw,58px)}
  .tf-logodiv{width:1px;height:clamp(38px,4vw,52px);background:var(--line);flex:none}
  .tf-wm{font-size:clamp(40px,7vw,84px);font-weight:800;letter-spacing:-.04em;line-height:.9;color:var(--text)}

  .tf-cta{text-align:right;display:flex;flex-direction:column;align-items:flex-end;gap:10px;padding-top:6px}
  .tf-cta .k{font-size:10.5px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--faint)}
  .tf-cta h3{font-size: clamp(18px, 1.8vw, 31px);
    font-weight: 700;
    letter-spacing: -.02em; 
    margin: 5px auto;}
.tf-btn
 {
    all: unset;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    font-size: 13.5px;
    padding: 12px 18px !important;
    border-radius: var(--r);
    margin-top: 0px;
    transition: transform .18s, box-shadow .2s, filter .2s;
}  .tf-btn:hover{transform:translateY(-1px);filter:brightness(1.06);box-shadow:0 12px 26px rgba(239,106,52,.3)}
  .tf-btn:focus-visible{outline:2px solid var(--accent);outline-offset:3px}

  .tf-hr{height:1px;background:var(--line);border:0}

  /* ── MID ── */
  .tf-mid{display:grid;grid-template-columns:1.7fr 1fr 1fr 1fr;gap:clamp(28px,3vw,26px);
    padding:clamp(34px,4vw,20px) 0}
  .tf-lead p{color:white;font-size:14px;line-height:1.7;margin-bottom:26px}
  .tf-info{display:flex;flex-direction:column;gap:12px}
  .tf-info .row{display:flex;gap:16px;align-items:baseline}
  .tf-info .lbl{flex:none;width:62px;font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--faint)}
  .tf-info .val{font-size:13px;color:var(--text);font-weight:600}
  .tf-info .val.on{color:var(--green);display:flex;align-items:center;gap:8px;font-weight:600}
  .tf-info .val.on::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--green);
    box-shadow:0 0 0 0 rgba(53,192,122,.5);animation:tfPulse 2.2s ease-out infinite}

  .tf-col h4{font-size:15.5px;text-transform:uppercase;letter-spacing:.16em;color:var(--accent);font-weight:700;margin-bottom:18px}
  .tf-col ul{list-style:none;display:flex;flex-direction:column;gap:13px;padding:0px}
  .tf-col a{color:var(--text);text-decoration:none;font-size:15.5px;transition:color .2s}
  .tf-col a:hover{color:var(--accent)}

  /* ── CONTACT ROW ── */
  .tf-contact{display:grid;grid-template-columns:1fr 1fr 1.2fr;padding:clamp(14px,1.6vw,12px) 0}
  .tf-contact .cell{padding-left:clamp(20px,2.4vw,34px)}
  .tf-contact .cell:first-child{padding-left:0}
  .tf-contact .cell + .cell{border-left:1px solid var(--line)}
  .tf-contact .lbl{font-size:10px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--faint);margin-bottom:9px}
  .tf-contact .big{font-size:15px;font-weight:700;color:var(--text)}
  .tf-contact a.big{text-decoration:none}
  .tf-contact a.big:hover{color:var(--accent)}
  .tf-offices{display:grid;grid-template-columns:1fr 1fr;gap:clamp(12px,1.6vw,18px);padding:clamp(16px,2vw,20px) 0}
  .tf-office{
    display:flex;align-items:flex-start;gap:14px;text-decoration:none;
    padding:clamp(16px,1.8vw,20px);border:1px solid var(--line);border-radius:14px;
    background:rgba(255,255,255,.02);transition:border-color .22s ease,background .22s ease,transform .22s ease;
  }
  .tf-office:hover{border-color:var(--accent);background:rgba(240,116,44,.05);transform:translateY(-2px)}
  .tf-office-pin{
    flex:none;width:40px;height:40px;border-radius:11px;display:grid;place-items:center;
    background:rgba(240,116,44,.12);color:var(--accent);transition:background .22s ease}
  .tf-office:hover .tf-office-pin{background:var(--accent);color:#fff}
  .tf-office-pin svg{width:20px;height:20px}
  .tf-office-body{display:flex;flex-direction:column;gap:5px;min-width:0}
  .tf-office-city{font-size:13px;font-weight:800;letter-spacing:.01em;color:var(--text);display:flex;align-items:center;gap:8px;flex-wrap:wrap}
  .tf-office-city em{
    font-style:normal;font-size:9.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;
    color:var(--accent);background:rgba(240,116,44,.12);padding:3px 7px;border-radius:999px}
  .tf-office address{font-style:normal;font-size:13.5px;line-height:1.55;color:var(--faint)}
  .tf-office:hover address{color:var(--text)}
  .tf-right{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
  .tf-mini{display:flex;gap:16px;font-size:12.5px}
  .tf-mini a{color:var(--muted);text-decoration:none;transition:color .2s}
  .tf-mini a:hover{color:var(--accent)}
  .tf-social{display:flex;gap:14px}
  .tf-social a{color:var(--muted);transition:color .2s}
  .tf-social a:hover{color:var(--accent)}

  /* ── BOTTOM ── */
  .tf-bottom{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;
    padding:20px 0 clamp(22px,3vw,34px);font-size:12px;color:var(--faint)}
  .tf-power{display:flex;align-items:center;gap:9px;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--faint)}
  .tf-power b{font-size:14px;letter-spacing:-.01em;text-transform:none;color:var(--text);font-weight:800}
  .tf-power b i{color:var(--accent);font-style:normal}
  .tf-power-logo{height:52px;width:auto;display:inline-block;vertical-align:middle}

  /* mega wordmark */
  .tf-mega{position:relative;z-index:0;text-align:center;line-height:.78;overflow:hidden;padding-bottom:clamp(6px,1.4vw,16px)}
  .tf-mega span{font-size:clamp(70px,16vw,220px);font-weight:800;letter-spacing:-.045em;
    color:rgba(255,255,255,.035);user-select:none;display:inline-block}

  @keyframes tfPulse{0%{box-shadow:0 0 0 0 rgba(53,192,122,.5)}70%{box-shadow:0 0 0 6px rgba(53,192,122,0)}100%{box-shadow:0 0 0 0 rgba(53,192,122,0)}}

  @media (max-width:900px){
    .tf-mid{grid-template-columns:1fr 1fr;gap:32px}
    .tf-lead{grid-column:1 / -1}
    .tf-contact{grid-template-columns:1fr}
    .tf-offices{grid-template-columns:1fr;gap:18px}
    .tf-contact .cell{padding-left:0;border-left:none!important;padding-top:18px;border-top:1px solid var(--line)}
    .tf-contact .cell:first-child{padding-top:0;border-top:none}
  }
  @media (max-width:560px){
    .tf-top{flex-direction:column}.tf-cta{text-align:left;align-items:flex-start}
    .tf-mid{grid-template-columns:1fr}
  }
  @media (prefers-reduced-motion:reduce){.tf *{animation:none!important;transition:none!important}}
</style>


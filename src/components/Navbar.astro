---
// AccrualOS navbar — sliding pill, home-only scroll morph + progress, mobile drawer.
const path = (Astro.url.pathname.replace(/\/+$/, '') || '/');
const isActive = (href: string) => {
  const h = (href.replace(/\/+$/, '') || '/');
  return h === '/' ? path === '/' : (path === h || path.startsWith(h + '/'));
};
---

<!-- Scroll progress bar (only visible when body[data-page="home"]) -->
<div class="progress"><i id="bar"></i></div>

<!-- The bar -->
<div class="navwrap">
  <nav class="nav" id="nav">

    <a class="brand" href="/">
      <img class="brand-logo" src="/accurallogo.png" alt="AccrualOS" />
    </a>

    <div class="menu" id="menu">
      <span class="pill" id="pill" aria-hidden="true"></span>

      <!-- active menu item (matching the current URL) gets class="lit" data-active -->
      <div class="mi"><a href="/" class:list={[isActive('/') && 'lit']} data-active={isActive('/') || undefined}>Home</a></div>

      <div class="mi"><a href="/about-us" class:list={[isActive('/about-us') && 'lit']} data-active={isActive('/about-us') || undefined}>About Us</a></div>

          <div class="mi"><a href="/#pm">What's included</a></div>

      <div class="mi has-dd">
        <a href="/services" class:list={[isActive('/services') && 'lit']} data-active={isActive('/services') || undefined}>Services
          <svg class="chev" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <div class="dd">
          <a href="/services/ai-deployment-accountants"><span>AI Deployment</span></a>
          <a href="/services/ai-analytics-reporting-accountants"><span>AI Analytics &amp; Reporting</span></a>
          <a href="/services/cybersecurity-ai-accountants"><span>Cybersecurity</span></a>
        </div>
      </div>

      <div class="mi"><a href="/packages" class:list={[isActive('/packages') && 'lit']} data-active={isActive('/packages') || undefined}>Plans</a></div>
      <div class="mi"><a href="/blog" class:list={[isActive('/blog') && 'lit']} data-active={isActive('/blog') || undefined}>Blog</a></div>
      <div class="mi"><a href="/contact-us" class:list={[isActive('/contact-us') && 'lit']} data-active={isActive('/contact-us') || undefined}>Contact</a></div>
    </div>

    <div class="nav-right">
     


      <a class="nav-cta" href="/contact-us"><span>Enquire Now</span>
        <i><svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M1 9L9 1M9 1H3.2M9 1v5.8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></i>
      </a>

      <button class="icon-btn burger" id="burger" aria-label="Open menu" aria-expanded="false">
        <svg width="15" height="11" viewBox="0 0 15 11" fill="none" aria-hidden="true"><path d="M0 1h15M0 5.5h15M0 10h15" stroke="currentColor" stroke-width="1.5"/></svg>
      </button>
    </div>

  </nav>
</div>

<!-- Mobile drawer -->
<div class="drawer" id="drawer">
  <button class="icon-btn drawer-close" id="drawerClose" aria-label="Close menu">
    <svg width="13" height="13" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M1 1l10 10M11 1L1 11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
  </button>
  <a href="/">Home</a>
  <a href="/about-us">About Us</a>
  <a href="/#pm">What's included</a>
  <a href="/services">Services</a>
  <a href="/services/ai-deployment-accountants" class="drawer-sub">AI Deployment</a>
  <a href="/services/ai-analytics-reporting-accountants" class="drawer-sub">AI Analytics &amp; Reporting</a>
  <a href="/services/cybersecurity-ai-accountants" class="drawer-sub">Cybersecurity</a>
  <a href="/packages">Plans</a>
  <a href="/blog">Blog</a>
  <a href="/contact-us">Contact</a>
</div>

<style is:global>
/* ══════════════════════════════════════════════════════════════════════════
   ACCRUALOS NAVBAR — COMPLETE STYLES
   ──────────────────────────────────────────────────────────────────────────
   Home page   →  <body data-page="home">    scroll morph + progress bar ON
   Other pages →  <body data-page="inner">   static bar, no progress bar
   ══════════════════════════════════════════════════════════════════════════ */

:root{
  --nav-paper:#FFFFFF;
  --nav-ink:#0E2E4D;
  --nav-muted:#5A6A7D;
  --nav-line:rgba(14,46,77,.11);
  --nav-teal:#2C7FB5;
  --nav-teal-lt:#7FC3E8;
  --nav-coral:#F0742C;
  --nav-font:"Manrope";   /* headlines */
  --nav-ease:cubic-bezier(.22,.85,.3,1);
}

/* ── 1. SCROLL PROGRESS BAR (home only) ────────────────────────────────── */
.progress{
  position:fixed;top:0;left:0;height:2px;width:100%;
  z-index:90;pointer-events:none;opacity:0;transition:opacity .3s;
}
body[data-page="home"] .progress{opacity:1}
.progress i{
  display:block;height:100%;width:0;
  background:linear-gradient(90deg,var(--nav-teal),var(--nav-teal-lt));
  transition:width .1s linear;
}

/* ── 2. THE BAR ────────────────────────────────────────────────────────── */
.navwrap{position:sticky;top:0;z-index:80}

.nav{
  position:relative;
  display:flex;align-items:center;gap:clamp(8px,2.4vw,20px);
  max-width:1400px;margin:15px auto;
  padding:16px clamp(12px,1.8vw,24px);
  font-family:var(--nav-font);color:var(--nav-ink);
  background:var(--nav-paper);
  border-bottom:1px solid var(--nav-line); justify-content: space-between !important;
  border-radius:0;
  transition:max-width .45s var(--nav-ease),padding .45s var(--nav-ease),
             border-radius .45s var(--nav-ease),background .45s var(--nav-ease),
             box-shadow .45s var(--nav-ease),transform .45s var(--nav-ease),
             border-color .45s var(--nav-ease);
}
.nav a{color:inherit;text-decoration:none}
.nav button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
.nav :focus-visible{outline:2px solid var(--nav-teal);outline-offset:3px;border-radius:8px}

/* morph state — JS adds this on the home page past 24px of scroll */
.nav.is-float{
  max-width:1080px;
  padding:9px 9px 9px 18px;
  border-radius:999px;
  
    justify-content: space-between !important;
  border-bottom-color:transparent;
  background:rgba(255,255,255,.82);
  -webkit-backdrop-filter:saturate(180%) blur(16px);
          backdrop-filter:saturate(180%) blur(16px);
  box-shadow:0 14px 34px rgba(14,46,77,.13);
  transform:translateY(10px);
}
.nav.is-float::after{
  content:"";position:absolute;inset:0;border-radius:999px;
  border:1px solid var(--nav-line);pointer-events:none;
}

/* ── 3. BRAND ──────────────────────────────────────────────────────────── */
.brand{display:flex;align-items:center;gap:10px;flex:none;padding-right:4px}
.brand .grid{display:grid;grid-template-columns:1fr 1fr;gap:2.5px;flex:none}
.brand .grid i{
  width:6px;height:6px;border-radius:1.5px;background:var(--nav-ink);
  transition:background .3s var(--nav-ease),transform .3s var(--nav-ease);
}
.brand:hover .grid i{background:var(--nav-teal)}
.brand:hover .grid i:nth-child(1){transform:translate(-1.5px,-1.5px)}
.brand:hover .grid i:nth-child(4){transform:translate(1.5px,1.5px)}
.brand b{font-weight:600;letter-spacing:.15em;font-size:13.5px}
.brand-logo{display:block;height:clamp(30px,3.4vw,40px);width:auto;max-width:100%}

/* ── 4. MENU + SLIDING PILL ────────────────────────────────────────────── */
.menu{position:relative;display:flex;align-items:center;gap:2px;flex:1;min-width:0}
.pill{
  position:absolute;top:50%;left:0;height:36px;margin-top:-18px;width:0;
  background:var(--nav-ink);border-radius:999px;opacity:0;pointer-events:none;
  transition:transform .38s var(--nav-ease),width .38s var(--nav-ease),opacity .25s var(--nav-ease);
}
.mi{position:relative}
.mi > a{
  position:relative;z-index:1;
  display:inline-flex;align-items:center;gap:6px;
  padding:9px 15px;border-radius:999px;
  font-size:13.5px;font-weight:700;white-space:nowrap;
  color:var(--nav-muted);transition:color .28s var(--nav-ease);
}
.mi > a.lit{color:#fff}
.mi > a .chev{width:9px;height:9px;opacity:.65;transition:transform .3s var(--nav-ease)}
.mi:hover > a .chev{transform:rotate(180deg)}

/* ── 5. DROPDOWN ───────────────────────────────────────────────────────── */
.dd{
  position:absolute;top:calc(100% + 14px);left:50%;min-width:236px;
  background:#fff;border:1px solid var(--nav-line);border-radius:16px;
  box-shadow:0 24px 50px -12px rgba(14,46,77,.24);padding:7px;z-index:5;
  opacity:0;visibility:hidden;transform:translateX(-50%) translateY(-8px) scale(.98);transform-origin:top center;
  transition:opacity .24s var(--nav-ease),transform .24s var(--nav-ease),visibility .24s;
}
/* invisible hover-bridge so the menu doesn't close in the gap */
.dd::before{content:"";position:absolute;left:0;right:0;top:-14px;height:14px}
/* little pointer notch */
.dd::after{content:"";position:absolute;top:-6px;left:50%;width:12px;height:12px;margin-left:-6px;
  background:#fff;border-left:1px solid var(--nav-line);border-top:1px solid var(--nav-line);
  transform:rotate(45deg);border-radius:3px 0 0 0}
.mi:hover .dd,.mi:focus-within .dd{opacity:1;visibility:visible;transform:translateX(-50%) translateY(0) scale(1)}
.dd a{
  position:relative;display:flex;align-items:center;gap:10px;
  padding:11px 14px 11px 16px;border-radius:11px;font-weight:700;font-size:13.5px;
  color:var(--nav-muted);white-space:nowrap;overflow:hidden;
  transition:background .2s var(--nav-ease),color .2s var(--nav-ease);
}
/* accent bar that grows in on hover */
.dd a::before{content:"";position:absolute;left:0;top:50%;height:0;width:3px;border-radius:0 3px 3px 0;
  background:var(--nav-coral);transform:translateY(-50%);transition:height .2s var(--nav-ease)}
.dd a span{transition:transform .2s var(--nav-ease)}
.dd a:hover{background:#F4F8FC;color:var(--nav-ink)}
.dd a:hover::before{height:56%}
.dd a:hover span{transform:translateX(3px)}
.dd a[aria-current],.dd a.lit{color:var(--nav-ink)}

/* ── 6. RIGHT-HAND CONTROLS ────────────────────────────────────────────── */
.nav-right{display:flex;align-items:center;gap:8px;flex:none}
.icon-btn{
  width:38px;height:38px;border-radius:999px;display:grid;place-items:center;
  border:1px solid var(--nav-line);color:var(--nav-ink);
  transition:background .2s var(--nav-ease),transform .2s var(--nav-ease);
}
.icon-btn:hover{background:#F1F5F9;transform:translateY(-1px)}
.login{font-size:13.5px;font-weight:500;color:var(--nav-muted);padding:9px 12px;transition:color .2s}
.login:hover{color:var(--nav-ink)}
.nav-cta{
  display:inline-flex;align-items:center;gap:10px;
  padding:8px 8px 8px 20px;border-radius:999px;
  border:0;background:#0E2E4D;color:#fff !important;
  font-size:13.5px;font-weight:600;
  box-shadow:0 10px 24px rgba(14,46,77,.22);
  transition:transform .2s var(--nav-ease),box-shadow .25s var(--nav-ease);
}
.nav-cta:hover{transform:translateY(-1px);box-shadow:0 16px 32px rgba(14,46,77,.30)}
.nav-cta i{
  width:24px;height:24px;border-radius:999px;flex:none;
  background:#F0742C;color:#fff;
  display:grid;place-items:center;font-style:normal;
  transition:transform .2s var(--nav-ease);
}
.nav-cta:hover i{transform:translate(2px,-2px)}
.burger{display:none}

/* ── 7. MOBILE DRAWER ──────────────────────────────────────────────────── */
.drawer{
  position:fixed;inset:0;z-index:85;background:#fff;padding:88px 26px 26px;
  font-family:var(--nav-font);color:var(--nav-ink);
  transform:translateY(-100%);transition:transform .5s var(--nav-ease);overflow-y:auto;
}
.drawer.open{transform:none}
.drawer a{
  display:block;padding:16px 0;text-decoration:none;color:inherit;
  font-size:24px;font-weight:500;letter-spacing:-.02em;
  border-bottom:1px solid var(--nav-line);
  opacity:0;transform:translateY(14px);
}
.drawer.open a{animation:navDrawerIn .5s var(--nav-ease) forwards}
@keyframes navDrawerIn{to{opacity:1;transform:none}}
.drawer-close{position:absolute;top:24px;right:24px}
.drawer .drawer-sub{
  font-size:17px;font-weight:500;color:var(--nav-muted);
  padding:12px 0 12px 18px;position:relative;
}
.drawer .drawer-sub::before{
  content:"";position:absolute;left:2px;top:50%;width:7px;height:7px;margin-top:-3.5px;
  border-radius:50%;background:var(--nav-coral);opacity:.7;
}

/* ── 8. RESPONSIVE ─────────────────────────────────────────────────────── */
@media (max-width:1080px){
  .menu{display:none}
  .login{display:none}
  .burger{display:grid}
}
@media (max-width:720px){
  .nav-cta span{display:none}
  .nav-cta{padding:8px}
}
@media (prefers-reduced-motion:reduce){
  .nav,.pill,.dd,.drawer,.drawer a,.icon-btn,.nav-cta,.brand .grid i{
    transition-duration:.01ms!important;animation:none!important;
  }
  .drawer a{opacity:1;transform:none}
}
</style>

<script is:inline>
/* ══════════════════════════════════════════════════════════════════════════
   ACCRUALOS NAVBAR — COMPLETE SCRIPT
   Sliding pill · home-only scroll morph + progress · mobile drawer
   No dependencies.
   ══════════════════════════════════════════════════════════════════════════ */
(function () {
  'use strict';

  var CONFIG = {
    floatAfter: 24,     // px scrolled before the bar morphs
    homeFlag: 'home'    // matched against <body data-page="...">
  };

  function init() {
    var nav     = document.getElementById('nav');
    var menu    = document.getElementById('menu');
    var pill    = document.getElementById('pill');
    var bar     = document.getElementById('bar');
    var burger  = document.getElementById('burger');
    var drawer  = document.getElementById('drawer');
    var closeEl = document.getElementById('drawerClose');
    if (!nav) return;

    /* ---- 1. sliding pill indicator ---- */
    var links = [], active = null, moveTo = function () {};

    if (menu && pill) {
      links  = Array.prototype.slice.call(menu.querySelectorAll('.mi > a'));
      active = menu.querySelector('[data-active]') || links[0];

      moveTo = function (el, instant) {
        if (!el || !menu.offsetParent) return;   // menu hidden on mobile
        var m = menu.getBoundingClientRect();
        var r = el.getBoundingClientRect();
        if (instant) pill.style.transition = 'none';
        pill.style.width     = r.width + 'px';
        pill.style.transform = 'translateX(' + (r.left - m.left) + 'px)';
        pill.style.opacity   = '1';
        if (instant) requestAnimationFrame(function () { pill.style.transition = ''; });
        links.forEach(function (l) { l.classList.toggle('lit', l === el); });
      };

      links.forEach(function (l) {
        l.addEventListener('mouseenter', function () { moveTo(l); });
        l.addEventListener('focus',      function () { moveTo(l); });
      });
      menu.addEventListener('mouseleave', function () { moveTo(active); });

      window.addEventListener('load',   function () { moveTo(active, true); });
      window.addEventListener('resize', function () { moveTo(active, true); });
      setTimeout(function () { moveTo(active, true); }, 150);  // after webfont swap
    }

    /* ---- 2. scroll morph + progress — HOME PAGE ONLY ---- */
    var lastFloat = null;

    function onScroll() {
      var y      = window.scrollY || document.documentElement.scrollTop;
      var isHome = document.body.dataset.page === CONFIG.homeFlag;
      var float  = isHome && y > CONFIG.floatAfter;

      if (float !== lastFloat) {
        nav.classList.toggle('is-float', float);
        lastFloat = float;
        // bar width changes, so re-measure the pill once the morph settles
        setTimeout(function () {
          moveTo((menu && menu.querySelector('.lit')) || active, true);
        }, 460);
      }

      if (bar) {
        var max = document.documentElement.scrollHeight - window.innerHeight;
        bar.style.width = (isHome && max > 0) ? (y / max) * 100 + '%' : '0%';
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    /* ---- 3. mobile drawer ---- */
    if (burger && drawer) {
      var items = drawer.querySelectorAll('a');
      Array.prototype.forEach.call(items, function (a, i) {
        a.style.animationDelay = (0.06 + i * 0.05) + 's';
      });

      var open = function () {
        drawer.classList.add('open');
        burger.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      };
      var close = function () {
        drawer.classList.remove('open');
        burger.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      };

      burger.addEventListener('click', open);
      if (closeEl) closeEl.addEventListener('click', close);
      Array.prototype.forEach.call(items, function (a) { a.addEventListener('click', close); });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && drawer.classList.contains('open')) close();
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

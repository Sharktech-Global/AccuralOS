<!-- ============================================================
     AccrualOS — HOW IT WORKS (dark band + overlapping card grid)
     Header sits inside a dark, image-backed hero box; the card
     grid is pulled up so the first row overlaps the band's edge.
     Self-contained fragment for GoHighLevel. Namespace: .hwc-*
     Palette: navy #0E2E4D / orange #E46E14. Manrope only.
     Flat 5px radius, no box-shadows. Image slot has a CSS fallback.
     ============================================================ -->
<section class="hwc-section" id="how-it-works" aria-labelledby="hwc-title" data-page="home">
  <style>
   
    .hwc-section{
      --hwc-navy:#0E2E4D;
      --hwc-navy-2:#16406B;
      --hwc-orange:#E46E14;
      --hwc-ink:#0E2E4D;
      --hwc-body:#5A6B7B;
      --hwc-bg:#F3F5F8;
      --hwc-card:#FFFFFF;
      --hwc-line:#E4E9EF;
      --hwc-r:25px;
      padding:80px 24px 88px;
      font-family:'Manrope',system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
      color:var(--hwc-body);
      -webkit-font-smoothing:antialiased;
    }
    .hwc-inner{margin:0 auto;}

    /* ---------- Dark hero band ---------- */
    .hwc-band{
      position:relative;overflow:hidden;
      border-radius:var(--hwc-r);
      padding:60px 56px 240px;              /* big bottom pad = the overlap zone */
      isolation:isolate;
      background:
        radial-gradient(120% 150% at 88% 15%, rgba(41,102,184,.38) 0%, rgba(14,46,77,0) 55%),
        radial-gradient(90% 130% at 6% 105%, rgba(41,102,184,.30) 0%, rgba(14,46,77,0) 50%),
        linear-gradient(130deg,#0A2038 0%, #0E2E4D 46%, #0B2A49 100%);
    }
    /* Optional background photo — hides on error, CSS gradient stays underneath */
    .hwc-band-bg{
      position:absolute;inset:0;width:100%;height:100%;object-fit:cover;
      z-index:0;opacity:.55;
    }
    /* soft flowing light-streak to echo the reference waves */
    .hwc-band::before{
      content:"";position:absolute;z-index:0;left:-10%;top:-40%;width:70%;height:180%;
      background:linear-gradient(90deg,rgba(70,130,210,0) 0%,rgba(70,130,210,.25) 50%,rgba(70,130,210,0) 100%);
      transform:rotate(-18deg);filter:blur(26px);opacity:.6;
    }
    /* left-weighted scrim keeps text readable over any photo */
    .hwc-band-scrim{ 
      position:absolute;inset:0;z-index:1;
      background:linear-gradient(90deg,rgba(9,26,46,.92) 0%,rgba(9,26,46,.55) 42%,rgba(9,26,46,0) 78%);
    }
    .hwc-dots{position:absolute;z-index:1;right:56px;top:50%;transform:translateY(-58%);opacity:.9;pointer-events:none;}

    .hwc-band-content{    position: relative;
    z-index: 2;
    max-width: 1280px; 
    margin: 0px auto;}
    .hwc-eyebrow{
      display:flex;align-items:center;gap:12px;margin:0 0 18px;
      font-size:12px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--hwc-orange);
    }
    .hwc-eyebrow::before{content:"";width:34px;height:2px;background:var(--hwc-orange);}
    .hwc-title{
          margin: 0 0 16px;
    color: #fff;
    font-size: clamp(30px, 4.2vw, 40px);
    line-height: 1.08;
    font-weight: 600;
    text-transform: capitalize;
    letter-spacing: -.02em;
    max-width: 26ch;
    }
    .hwc-sub{margin:0;max-width:660px;font-size:16px;line-height:1.65;font-weight:500;color:rgba(255,255,255,.74);}

    /* ---------- Grid (pulled up into the band) ---------- */
    .hwc-grid{
     position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: -150px !important;
    max-width: 1300px;
    margin: 0px auto;
    padding: 0 34px;                            /* inset < band width, so box is wider than cards */
    }
    .hwc-card{
      min-width:0;background:var(--hwc-card);
      border:1px solid var(--hwc-line);border-radius:5px;overflow:hidden;
      display:flex;flex-direction:column;
      opacity:0;transform:translateY(18px);transition:opacity .6s ease, transform .6s ease;
    }
    .hwc-card.is-in{opacity:1;transform:none;}

    .hwc-media{
      position:relative;aspect-ratio:16/10;overflow:hidden;
      background:linear-gradient(135deg,var(--hwc-navy) 0%,var(--hwc-navy-2) 100%);
    }
    .hwc-media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;}
    .hwc-media::after{
      content:"";position:absolute;inset:0;
      background:linear-gradient(180deg,rgba(14,46,77,.28) 0%,rgba(14,46,77,0) 34%,rgba(14,46,77,.55) 100%);
    }
    .hwc-ghost{position:absolute;right:14px;bottom:6px;z-index:1;font-size:78px;font-weight:800;line-height:1;letter-spacing:-.03em;color:rgba(255,255,255,.10);user-select:none;}
    .hwc-tag{
      position:absolute;top:14px;left:14px;z-index:2;display:inline-flex;align-items:center;
      padding:5px 10px;border-radius:var(--hwc-r);background:rgba(228,110,20,.92);
      color:#fff;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;
    }
    .hwc-badge{
      position:absolute;left:14px;bottom:14px;z-index:2;width:42px;height:42px;border-radius:var(--hwc-r);
      display:flex;align-items:center;justify-content:center;
      background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.34);backdrop-filter:blur(2px);
    }
    .hwc-badge svg{width:20px;height:20px;stroke:#fff;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;}

    .hwc-cbody{padding: 22px 22px 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
    background-color: #091e4a0a;}
    .hwc-h3{margin:0 0 9px;font-size:19px;font-weight:800;letter-spacing:-.01em;color:var(--hwc-ink);}
    .hwc-p{margin:0;font-size:14.5px;line-height:1.62;font-weight:500;color:var(--hwc-body);}
    .hwc-foot{margin-top:16px;display:inline-flex;align-items:center;gap:7px;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--hwc-orange);}
    .hwc-foot::before{content:"";width:14px;height:2px;background:var(--hwc-orange);}

    /* ---------- Responsive ---------- */
    @media (max-width:920px){
      .hwc-dots{display:none;}
      .hwc-band{padding:52px 34px 150px;}3
      .hwc-band-content{max-width:none;}
      .hwc-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:22px;margin-top:-118px;padding:0 22px;}
    }
    @media (max-width:600px){
      .hwc-section{padding:6px 0px 30px;}
      .hwc-band{padding:44px 15px 120px;   border-radius: 0px }
      .hwc-grid{grid-template-columns:1fr;margin-top:-92px !important;padding:0 14px;    }
    }
    @media (prefers-reduced-motion:reduce){
      .hwc-card{opacity:1;transform:none;transition:none;}
    }
  </style>

  <div class="hwc-inner">

    <!-- DARK HERO BAND -->
    <div class="hwc-band">
      <img class="hwc-band-bg" src="/homecard5.jpg" alt="" aria-hidden="true" onerror="this.style.display='none'">
      <span class="hwc-band-scrim" aria-hidden="true"></span>
      <span class="hwc-dots" aria-hidden="true"><!-- dot pyramid injected by script --></span>

      <div class="hwc-band-content">
        <p class="hwc-eyebrow">How it works</p>
        <h2 id="hwc-title" class="hwc-title">Configured for your firm — not handed over as an empty account.</h2>
        <p class="hwc-sub">A standard implementation may target 21 days once the required information, access and approvals are received. The approved project plan states the actual go-live date.</p>
      </div>
    </div>

    <!-- OVERLAPPING CARD GRID -->
    <div class="hwc-grid">

      <article class="hwc-card">
        <div class="hwc-media">
          <img src="/path1.jpg" alt="" loading="lazy" onerror="this.style.display='none'">
          <span class="hwc-ghost">01</span><span class="hwc-tag">Step 01</span>
          <span class="hwc-badge"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg></span>
        </div>
        <div class="hwc-cbody">
          <h3 class="hwc-h3">Discover</h3>
          <p class="hwc-p">Map services, enquiry sources, team responsibilities, software and current processes.</p>
          <span class="hwc-foot">Kick-off</span>
        </div>
      </article>

      <article class="hwc-card">
        <div class="hwc-media">
          <img src="/path2.jpg" alt="" loading="lazy" onerror="this.style.display='none'">
          <span class="hwc-ghost">02</span><span class="hwc-tag">Step 02</span>
          <span class="hwc-badge"><svg viewBox="0 0 24 24"><line x1="4" y1="7" x2="20" y2="7"/><circle cx="9" cy="7" r="2.2"/><line x1="4" y1="17" x2="20" y2="17"/><circle cx="15" cy="17" r="2.2"/></svg></span>
        </div>
        <div class="hwc-cbody">
          <h3 class="hwc-h3">Configure</h3>
          <p class="hwc-p">Build pipelines, forms, calendars, templates, workflows and approved AI knowledge.</p>
          <span class="hwc-foot">Build</span>
        </div>
      </article>

      <article class="hwc-card">
        <div class="hwc-media">
          <img src="/path3.jpg" alt="" loading="lazy" onerror="this.style.display='none'">
          <span class="hwc-ghost">03</span><span class="hwc-tag">Step 03</span>
          <span class="hwc-badge"><svg viewBox="0 0 24 24"><path d="M5 4h14v3l-5 6v6l-4-2v-4L5 7z"/></svg></span>
        </div>
        <div class="hwc-cbody">
          <h3 class="hwc-h3">Test</h3>
          <p class="hwc-p">Run realistic enquiry, onboarding, communication and exception scenarios.</p>
          <span class="hwc-foot">Validation</span>
        </div>
      </article>

      <article class="hwc-card">
        <div class="hwc-media">
          <img src="/path4.jpg" alt="" loading="lazy" onerror="this.style.display='none'">
          <span class="hwc-ghost">04</span><span class="hwc-tag">Step 04</span>
          <span class="hwc-badge"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0"/><path d="M16 6.2a3 3 0 0 1 0 5.6"/><path d="M18 13.5a5.5 5.5 0 0 1 2.5 4.5"/></svg></span>
        </div>
        <div class="hwc-cbody">
          <h3 class="hwc-h3">Train</h3>
          <p class="hwc-p">Show the team how to manage records, conversations, tasks and handovers.</p>
          <span class="hwc-foot">Enablement</span>
        </div>
      </article>

      <article class="hwc-card">
        <div class="hwc-media">
          <img src="/path5.jpg" alt="" loading="lazy" onerror="this.style.display='none'">
          <span class="hwc-ghost">05</span><span class="hwc-tag">Step 05</span>
          <span class="hwc-badge"><svg viewBox="0 0 24 24"><path d="M12 3c3.5 1 6 4.5 6 8.5L15 15l-3 3-3-3-3-3.5C6 7.5 8.5 4 12 3z"/><circle cx="12" cy="10" r="1.6"/><path d="M9 18l-2 3"/><path d="M15 18l2 3"/></svg></span>
        </div>
        <div class="hwc-cbody">
          <h3 class="hwc-h3">Go live</h3>
          <p class="hwc-p">Launch the agreed modules and monitor early activity.</p>
          <span class="hwc-foot">Launch</span>
        </div>
      </article>

      <article class="hwc-card">
        <div class="hwc-media">
          <img src="/path6.jpg" alt="" loading="lazy" onerror="this.style.display='none'">
          <span class="hwc-ghost">06</span><span class="hwc-tag">Step 06</span>
          <span class="hwc-badge"><svg viewBox="0 0 24 24"><path d="M20 12a8 8 0 1 1-2.3-5.6"/><path d="M20 4v4h-4"/><path d="M8 13l2.5 2.5L16 10"/></svg></span>
        </div>
        <div class="hwc-cbody">
          <h3 class="hwc-h3">Improve</h3>
          <p class="hwc-p">Review results, refine workflows and add approved automation when required.</p>
          <span class="hwc-foot">Optimise</span>
        </div>
      </article>

    </div>
  </div>

  <script is:inline>
    (function(){
      var root = document.currentScript.closest('.hwc-section');
      if(!root) return;

      /* --- build the dot pyramid (signature motif) --- */
      var host = root.querySelector('.hwc-dots');
      if(host){
        var rows=9, gap=20, r=3.2, pad=6;
        var w=(rows-1)*gap + pad*2, h=(rows-1)*gap + pad*2;
        var ns='http://www.w3.org/2000/svg';
        var svg=document.createElementNS(ns,'svg');
        svg.setAttribute('width',w); svg.setAttribute('height',h);
        svg.setAttribute('viewBox','0 0 '+w+' '+h);
        for(var row=0; row<rows; row++){
          var count=row+1, startX=(w-(count-1)*gap)/2, y=pad+row*gap;
          for(var i=0;i<count;i++){
            var c=document.createElementNS(ns,'circle');
            c.setAttribute('cx',startX+i*gap); c.setAttribute('cy',y); c.setAttribute('r',r);
            var fill='rgba(255,255,255,'+(0.12+(row/rows)*0.42).toFixed(2)+')';
            if(i===row)            fill='#E46E14';                 /* orange right edge */
            else if(i===Math.floor(row/2) && row>2) fill='rgba(96,150,214,.85)'; /* cool navy-tint streak */
            c.setAttribute('fill',fill);
            svg.appendChild(c);
          }
        }
        host.appendChild(svg);
      }

      /* --- scroll reveal --- */
      var cards = root.querySelectorAll('.hwc-card');
      if(!('IntersectionObserver' in window)){ cards.forEach(function(c){c.classList.add('is-in');}); return; }
      var io=new IntersectionObserver(function(es){
        es.forEach(function(e){
          if(e.isIntersecting){
            var i=Array.prototype.indexOf.call(cards,e.target);
            e.target.style.transitionDelay=(i%3)*90+'ms';
            e.target.classList.add('is-in'); io.unobserve(e.target);
          }
        });
      },{threshold:0.16, rootMargin:'0px 0px -8% 0px'});
      cards.forEach(function(c){io.observe(c);});
    })();
  </script>
</section>
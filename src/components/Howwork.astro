<style>
/* ══════════════════════════════════════════════════════════════════════════
   ACCRUALOS · THE PROBLEM — component (image cards)
   Embeddable: no html/head/body. Load Manrope in your site head. Scoped .pb.
   ══════════════════════════════════════════════════════════════════════════ */
.pb{
  --ink:#0E2E4D;--body:#42506A;--muted:#7B8698;--orange:#E46E14;
  --coral:#F0742C;--teal:#38A0DE;--purple:#8A78E6;--amber:#E0A93C;
  --line:rgba(14,46,77,.12);--line-soft:rgba(14,46,77,.08);
  --r:5px;
  --font:"Manrope",ui-sans-serif;
  --ease:cubic-bezier(.22,.85,.3,1);
  background:#fff;font-family:var(--font);color:var(--ink);padding:clamp(56px,7vw,110px) 0;
}
.pb *{box-sizing:border-box}
.pb-wrap{max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,44px)}

/* header: two frames, top-aligned */
.pb-head{display:grid;    grid-template-columns: 1.15fr .85fr;gap:clamp(24px,4vw,60px);align-items:start;
  opacity:0;transform:translateY(18px);transition:opacity .8s var(--ease),transform .8s var(--ease)}
.pb.in .pb-head{opacity:1;transform:none}
.pb-kicker{display:inline-flex;align-items:center;gap:11px;font-size:12px;font-weight:600;
  letter-spacing:.2em;text-transform:uppercase;color:var(--orange);margin-bottom:16px}
.pb-kicker::before{content:"";width:30px;height:2px;background:var(--orange)}
.pb h2{    margin: 0;
    font-size: clamp(26px, 3vw, 41px);
    font-weight: 700;
    line-height: 1.14;
    text-transform: capitalize;
    letter-spacing: -.026em;}
.pb-head-r{
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding-top: 35px;
}
.pb-sub{margin:0;font-size:16px;line-height:1.6;color:var(--body);max-width:46ch}
.pb-btn{display:inline-flex;align-items:center;gap:10px;white-space:nowrap;
  padding:13px 22px;border-radius:var(--r);background:var(--ink);color:#fff;text-decoration:none;
  font-size:14px;font-weight:700;transition:background .2s,transform .2s}
.pb-btn:hover{background:#163a5e;transform:translateY(-2px)}
.pb-btn svg{width:12px;height:12px}

/* cards */
.pb-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin-top:clamp(38px,4.4vw,58px)}
.pb-card{display:flex;flex-direction:column;opacity:0;transform:translateY(18px);
  transition:opacity .6s var(--ease),transform .6s var(--ease)}
.pb.in .pb-card{opacity:1;transform:none}
.pb.in .pb-card:nth-child(2){transition-delay:.08s}
.pb.in .pb-card:nth-child(3){transition-delay:.16s}
.pb.in .pb-card:nth-child(4){transition-delay:.24s}
.pb-card[data-acc="coral"] {--acc:var(--coral)}
.pb-card[data-acc="teal"]  {--acc:var(--teal)}
.pb-card[data-acc="purple"]{--acc:var(--purple)}
.pb-card[data-acc="amber"] {--acc:var(--amber)}

/* image panel */
.pb-visual{    position: relative;
    border-radius: var(--r);
    overflow: hidden;
    aspect-ratio: 8 / 4;
    background: #0b1e33;
    /* border: 1px solid #ffffff0f; */
    /* transition: transform .3s var(--ease), box-shadow .3s var(--ease); */
}
.pb-card:hover .pb-visual{transform:translateY(-4px);box-shadow:0 24px 46px rgba(11,30,51,.30)}
.pb-visual img{width:100%;height:100%;object-fit:cover;display:block}

.pb-num{font-size:12px;font-weight:600;color:var(--acc);    margin: 16px 5px 8px;letter-spacing:.02em}
.pb-title{margin:0;font-size:28px;font-weight:700;letter-spacing:-.01em;color:var(--ink);    margin: 6px 5px 8px;}
.pb-rule{height:1px;background:var(--line);    margin: 6px 5px 8px;}
.pb-card:hover .pb-rule{background:var(--acc)}
.pb-desc{margin:0;font-size:14px;line-height:1.58;color:var(--body);    margin: 6px 5px 8px;}

@media (max-width:1000px){
  .pb-head{grid-template-columns:1fr;gap:24px}
  .pb-grid{grid-template-columns:repeat(2,1fr)}
}
@media (max-width:560px){.pb-grid{grid-template-columns:1fr}}
@media (prefers-reduced-motion:reduce){
  .pb-head,.pb-card{opacity:1;transform:none;transition:none}
}
</style>

<!-- ══════════ THE PROBLEM ══════════ -->
<section class="pb" id="pb" aria-label="The problem">
  <div class="pb-wrap">

    <div class="pb-head">
      <div class="pb-head-l">
        <div class="pb-kicker">The problem</div>
        <h2>Your client work should not depend on inboxes, spreadsheets and staff memory.</h2>
      </div>
      <div class="pb-head-r">
        <p class="pb-sub">When the client side of the practice lives across scattered tools, work slips through the gaps. These are the four that cost firms the most.</p>
        <a class="pb-btn" href="/services">Explore the platform
          <svg viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M1 5h8M5.5 1.5L9 5l-3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>

    <div class="pb-grid">

      <!-- 01 Enquiries go cold -->
      <article class="pb-card" data-acc="coral">
        <div class="pb-visual">
          <img src="/pro1.jpg" alt="Enquiries go cold" onerror="this.style.display='none'">
        </div>
        <div class="pb-num">01</div>
        <h3 class="pb-title">Enquiries go cold</h3>
        <div class="pb-rule"></div>
        <p class="pb-desc">New enquiries sit in shared inboxes without a clear owner or next step.</p>
      </article>

      <!-- 02 Onboarding takes too long -->
      <article class="pb-card" data-acc="teal">
        <div class="pb-visual">
          <img src="/pro2.jpg" alt="Onboarding takes too long" onerror="this.style.display='none'">
        </div>
        <div class="pb-num">02</div>
        <h3 class="pb-title">Onboarding takes too long</h3>
        <div class="pb-rule"></div>
        <p class="pb-desc">Forms, meetings, reminders and handoffs are managed manually.</p>
      </article>

      <!-- 03 Information arrives late -->
      <article class="pb-card" data-acc="purple">
        <div class="pb-visual">
          <img src="/pro3.jpg" alt="Information arrives late" onerror="this.style.display='none'">
        </div>
        <div class="pb-num">03</div>
        <h3 class="pb-title">Information arrives late</h3>
        <div class="pb-rule"></div>
        <p class="pb-desc">Staff spend billable time repeatedly chasing the same client information.</p>
      </article>

      <!-- 04 Partners lack visibility -->
      <article class="pb-card" data-acc="amber">
        <div class="pb-visual">
          <img src="/pro4.jpg" alt="Partners lack visibility" onerror="this.style.display='none'">
        </div>
        <div class="pb-num">04</div>
        <h3 class="pb-title">Partners lack visibility</h3>
        <div class="pb-rule"></div>
        <p class="pb-desc">It is hard to see what is waiting, who owns it and where attention is needed.</p>
      </article>

    </div>
  </div>
</section>

<script is:inline>
(function () {
  'use strict';
  function init() {
    var s = document.getElementById('pb'); if (!s) return;
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (e) {
        e.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
      }, { threshold: 0.12 });
      io.observe(s);
    } else { s.classList.add('in'); }
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
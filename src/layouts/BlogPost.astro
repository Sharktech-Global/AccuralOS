---
import Layout from './Layout.astro';
const { frontmatter } = Astro.props;
const title = frontmatter?.title ?? 'AccrualOS Blog';
const description = frontmatter?.description ?? '';
const brand = frontmatter?.brand ?? 'AccrualOS by Sharktech Global';
const image = frontmatter?.image ?? '';
---

<Layout title={`${title} — AccrualOS Blog`} description={description}>
  <article class="bpost">
    <div class="bpost-wrap">
      <nav class="bpost-crumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><a href="/blog">Blog</a><span>/</span><em>Article</em>
      </nav>
      <span class="bpost-brand">{brand}</span>
      {image && (
        <figure class="bpost-cover">
          <img src={image} alt={title} loading="eager" onerror="this.closest('.bpost-cover').style.display='none'" />
        </figure>
      )}
      <div class="bpost-body">
        <slot />
      </div>
      <div class="bpost-foot">
        <a class="bpost-cta" href="/contact-us">Map your first workflow
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a class="bpost-back" href="/blog">← All articles</a>
      </div>
    </div>
  </article>
</Layout>

<style is:global>
  .bpost{
    --bp-navy:#0E2E4D; --bp-body:#41586e; --bp-muted:#5b7085; --bp-line:#e6eaf0;
    --bp-orange:#E46E14; --bp-soft:#f5f8fb;
    background:#fff;color:var(--bp-navy);
    font-family:'Manrope',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
    padding:clamp(40px,5vw,72px) 0 clamp(56px,7vw,96px);
  }
  .bpost *{box-sizing:border-box;}
  .bpost-wrap{max-width:1120px;margin:0 auto;padding:0 clamp(18px,4vw,28px);}

  .bpost-crumb{display:flex;align-items:center;gap:8px;font-size:13px;font-weight:600;color:var(--bp-muted);margin:0 0 22px;flex-wrap:wrap;}
  .bpost-crumb a{color:var(--bp-muted);text-decoration:none;transition:color .2s;}
  .bpost-crumb a:hover{color:var(--bp-orange);}
  .bpost-crumb em{color:var(--bp-navy);font-style:normal;}

  .bpost-brand{
    display:inline-flex;align-items:center;gap:9px;margin:0 0 14px;
    font-size:.72rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--bp-orange);
  }
  .bpost-brand::before{content:"";width:24px;height:2px;background:var(--bp-orange);}

  .bpost-cover{margin:22px 0 34px;}
  .bpost-cover img{
    display:block;width:100%;aspect-ratio:16/8;object-fit:cover;
    border-radius:16px;border:1px solid var(--bp-line);
    box-shadow:0 30px 60px -40px rgba(14,46,77,.5);
  }

  /* PROSE */
  .bpost-body{font-size:16.5px;line-height:1.8;color:var(--bp-body);}
  .bpost-body > *:first-child{margin-top:0;}
  .bpost-body h1{
    font-size:clamp(30px,4.4vw,44px);font-weight:800;letter-spacing:-.025em;line-height:1.14;
    color:var(--bp-navy);margin:0 0 24px;
  }
  .bpost-body h2{
    font-size:clamp(22px,2.8vw,30px);font-weight:800;letter-spacing:-.02em;line-height:1.2;
    color:var(--bp-navy);margin:52px 0 16px;padding-top:8px;
  }
  .bpost-body h3{
    font-size:clamp(18px,2vw,21px);font-weight:700;letter-spacing:-.01em;
    color:var(--bp-navy);margin:34px 0 12px;
  }
  .bpost-body p{margin:0 0 20px;}
  .bpost-body a{color:var(--bp-orange);text-decoration:underline;text-underline-offset:2px;text-decoration-thickness:1px;transition:opacity .2s;}
  .bpost-body a:hover{opacity:.72;}
  .bpost-body strong{color:var(--bp-navy);font-weight:700;}
  .bpost-body ul,.bpost-body ol{margin:0 0 22px;padding-left:22px;}
  .bpost-body li{margin:0 0 9px;padding-left:4px;}
  .bpost-body li::marker{color:var(--bp-orange);font-weight:700;}
  .bpost-body blockquote{
    margin:26px 0;padding:14px 22px;border-left:3px solid var(--bp-orange);
    background:var(--bp-soft);border-radius:0 10px 10px 0;color:var(--bp-navy);font-style:italic;
  }
  .bpost-body hr{border:0;border-top:1px solid var(--bp-line);margin:40px 0;}
  .bpost-body code{
    background:var(--bp-soft);border:1px solid var(--bp-line);border-radius:6px;
    padding:2px 6px;font-size:.9em;font-family:'IBM Plex Mono',ui-monospace,monospace;color:var(--bp-navy);
  }

  .bpost-foot{
    display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap;
    margin-top:56px;padding-top:30px;border-top:1px solid var(--bp-line);
  }
  .bpost-cta{
    display:inline-flex;align-items:center;gap:10px;
    padding:13px 22px;border-radius:999px;background:var(--bp-navy);color:#fff;
    font-weight:700;font-size:.95rem;text-decoration:none;
    box-shadow:0 12px 26px -14px rgba(14,46,77,.5);transition:transform .2s,box-shadow .25s;
  }
  .bpost-cta svg{width:17px;height:17px;color:var(--bp-orange);transition:transform .2s;}
  .bpost-cta:hover{transform:translateY(-1px);box-shadow:0 18px 34px -14px rgba(14,46,77,.55);}
  .bpost-cta:hover svg{transform:translateX(3px);}
  .bpost-back{color:var(--bp-muted);font-weight:600;font-size:.95rem;text-decoration:none;transition:color .2s;}
  .bpost-back:hover{color:var(--bp-orange);}

  @media (max-width:560px){
    .bpost-foot{flex-direction:column-reverse;align-items:flex-start;}
  }
</style>

---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const SITE_NAME = 'AccrualOS';
const DEFAULT_TITLE = 'AccrualOS — Practice management & automation for Australian accounting firms';
const DEFAULT_DESC =
  'AccrualOS is the practice-management and automation platform built only for Australian accounting and bookkeeping firms — one system to run the enquiries, chase the documents and file the paperwork, so your team gets its time back.';

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESC,
  image = '/accurallogo.png',
  noindex = false,
} = Astro.props;

const base = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, base).href;
const ogImage = new URL(image, base).href;
const siteOrigin = new URL(base).origin;

const entityGraph = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'SoftwareApplication',
			'@id': `${siteOrigin}/#software`,
			name: 'AccrualOS',
			url: `${siteOrigin}/`,
			applicationCategory: 'BusinessApplication',
			operatingSystem: 'Web',
			description:
				'AccrualOS is an accounting practice management and growth platform for Australian firms. It connects CRM, enquiries, appointments, client communication, onboarding, workflow follow-up, AI assistants and managed growth services in one configured system.',
			image: `${siteOrigin}/accurallogo.png`,
			publisher: { '@id': 'https://www.sharktech.com.au/#organization' },
		},
		{
			'@type': 'Organization',
			'@id': `${siteOrigin}/#organization`,
			name: 'AccrualOS',
			url: `${siteOrigin}/`,
			logo: `${siteOrigin}/accurallogo.png`,
			parentOrganization: { '@id': 'https://www.sharktech.com.au/#organization' },
		},
		{
			'@type': 'Organization',
			'@id': 'https://www.sharktech.com.au/#organization',
			name: 'Sharktech Global',
			url: 'https://www.sharktech.com.au',
			employee: { '@id': 'https://www.dainudevis.com/#person' },
		},
		{
			'@type': 'Person',
			'@id': 'https://www.dainudevis.com/#person',
			name: 'Dainu Devis',
			jobTitle: 'CEO',
			url: 'https://www.dainudevis.com',
			worksFor: { '@id': 'https://www.sharktech.com.au/#organization' },
		},
	],
};
const entityJson = JSON.stringify(entityGraph).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/accuralsym.png" />
		<link rel="apple-touch-icon" href="/accuralsym.png" />
		<meta name="generator" content={Astro.generator} />

		<!-- Primary SEO -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
		<meta name="theme-color" content="#0E2E4D" />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:locale" content="en_AU" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<script type="application/ld+json" set:html={entityJson} />

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Poppins:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
	</head>
	<body data-page="home">
		<Navbar />
		<slot />
				<Footer />

		<!-- LeadConnector chat widget -->
		<script src="https://widgets.leadconnectorhq.com/loader.js" data-resources-url="https://widgets.leadconnectorhq.com/chat-widget/loader.js" data-widget-id="6a38fff98a36b56829666495" is:inline></script>
	</body>
</html>

<style is:global>
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}
	html,
	body {
		margin: 0;
		width: 100%;
	}
	body {
		min-height: 100%;
	}
	body {
		font-family:"manrope";
		color: #0E2E4D;
		background: #fff;
	}
</style>

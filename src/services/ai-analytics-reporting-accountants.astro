<script is:inline>
(function(){
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* FAQ: one open at a time, and always keep one open. */
  var faqItems = document.querySelectorAll('.ai-svc .faq details');
  faqItems.forEach(function(d){
    d.addEventListener('toggle', function(){
      if(d.open){
        faqItems.forEach(function(o){ if(o !== d){ o.open = false; } });
      } else {
        var anyOpen = Array.prototype.some.call(faqItems, function(o){ return o.open; });
        if(!anyOpen){ d.open = true; }
      }
    });
  });

  if(!reduce && 'IntersectionObserver' in window){
    var els = document.querySelectorAll('.ai-svc .card,.ai-svc .step,.ai-svc .kpi,.ai-svc .callout,.ai-svc .visual');
    els.forEach(function(el){
      el.style.opacity = '0';
      el.style.transform = 'translateY(14px)';
      el.style.transition = 'opacity .5s ease, transform .5s ease';
    });
    var obs = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){
          e.target.style.opacity = '1';
          e.target.style.transform = 'none';
          obs.unobserve(e.target);
        }
      });
    },{threshold:0.12});
    els.forEach(function(el){ obs.observe(el); });
  }
})();
</script>

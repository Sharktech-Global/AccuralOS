<!-- HOW IT WORKS -->
<section id="how-it-works">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow">How Sharktech delivers</div>
      <h2>Scope the bottleneck first. Build the right solution second.</h2>
      <p>AccrualOS is the fixed-price product layer. Custom AI deployment is scoped separately and quoted per job.</p>
    </div>
    <div class="process">
      <div class="step"><div class="tag">01</div><div><b>Discovery and business case</b><p>Identify the workflow bottleneck, the current effort and the outcome management wants to improve.</p></div></div>
      <div class="step"><div class="tag">02</div><div><b>Data and systems audit</b><p>Map the applications, spreadsheets, permissions and data sources involved in the process.</p></div></div>
      <div class="step"><div class="tag">03</div><div><b>Scope and controls</b><p>Define automation boundaries, human approvals, access rules and implementation responsibilities.</p></div></div>
      <div class="step"><div class="tag">04</div><div><b>Build and test</b><p>Configure the agreed AI and workflow solution and test it against realistic scenarios.</p></div></div>
      <div class="step"><div class="tag">05</div><div><b>Launch and measure</b><p>Train the team, release the solution and track whether the intended operational result improved.</p></div></div>
    </div>
  </div>
</section>

<!-- MEASURE -->
<section style="background:var(--soft)">

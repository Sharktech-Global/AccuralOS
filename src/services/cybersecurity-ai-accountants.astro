<!-- AccrualOS: Cybersecurity & Secure AI Deployment - GHL fragment -->
<style>
@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&family=Poppins:wght@400;500;600;700&display=swap');
:root{
  --paper:#ffffff;
  --ink:#0E2E4D;
  --muted:#5b7085;
  --line:#e3e9ef;
  --soft:#f5f8fb;
  --dark:#0E2E4D;
  --accent:#E46E14;
  --accent-soft:#fbeee3;
  --accent-line:#f3d6bd;
  --r:5px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  background:var(--paper);
  color:var(--ink);
  font-family:"Poppins",ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
}
a{color:inherit}
h1,h2,h3,.eyebrow,.faq summary{font-family:"Manrope",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}
.container{width:min(1120px,calc(100% - 40px));margin:0 auto}
.btn{
  display:inline-flex;align-items:center;justify-content:center;
  padding:13px 22px;border-radius:var(--r);text-decoration:none;font-weight:700;
  border:1px solid transparent;transition:transform .2s ease,background .2s ease,border-color .2s ease
}
.btn-primary{background:var(--accent);color:white}
.btn-primary:hover{transform:translateY(-1px)}
.btn-secondary{border-color:var(--line);background:white;color:var(--ink)}
.btn-secondary:hover{border-color:var(--accent)}

/* HERO */
.hero{position:relative;overflow:hidden;padding:84px 0 72px;background:var(--paper)}
.hero::before{
  content:"";position:absolute;inset:0;pointer-events:none;
  background-image:
    linear-gradient(to right, rgba(14,46,77,.045) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(14,46,77,.045) 1px, transparent 1px);
  background-size:44px 44px;
  -webkit-mask-image:radial-gradient(circle at 50% 24%, #000 0%, transparent 70%);
  mask-image:radial-gradient(circle at 50% 24%, #000 0%, transparent 70%);
}
.hero .container{position:relative;z-index:1}
.hero-grid{display:grid;grid-template-columns:.95fr 1.05fr;gap:48px;align-items:center}
.hero-copy{max-width:600px}
.eyebrow{display:inline-flex;gap:8px;align-items:center;font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.12em;color:var(--accent)}
.hero h1{font-size:clamp(40px,4.4vw,44px);line-height:1.2;letter-spacing:-.04em;margin:16px 0}
.hero .lead{font-size:18px;max-width:720px;color:var(--muted);margin:0 0 26px}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap}
.trustline{display:flex;gap:18px;flex-wrap:wrap;margin-top:28px;color:var(--muted);font-size:13.5px}
.trustline span{display:inline-flex;align-items:center;gap:8px}
.trustline span:before{content:"";width:8px;height:8px;border-radius:50%;background:var(--accent);flex:0 0 auto}

/* VISUAL FRAME (SVG mock with optional real screenshot on top) */
.visual{position:relative;border:1px solid var(--line);border-radius:10px;background:white;overflow:hidden}
.visual svg{display:block;width:100%;height:auto}
.visual .shot{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border-radius:10px}
.dark .visual{border-color:rgba(255,255,255,.14)}

section{padding:76px 0}
.section-head{max-width:760px;margin-bottom:34px}
.section-head h2{font-size:clamp(30px,4vw,44px);line-height:1.1;letter-spacing:-.03em;margin:8px 0 14px}
.section-head p{color:var(--muted);font-size:17px;margin:0}
.grid-3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.grid-2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.card{position:relative;border:1px solid var(--line);border-top:3px solid var(--accent);border-radius:var(--r);padding:28px;background:#fff;min-width:0;transition:transform .2s ease,border-color .2s ease,background .2s ease}
.card:hover{transform:translateY(-4px);border-color:var(--accent);background:linear-gradient(180deg,#ffffff 0%,#fff8f2 100%)}
.card:hover .ico{transform:scale(1.06)}
.card h3{margin:14px 0 8px;font-size:20px}
.card p{margin:0;color:var(--muted)}
.ico{width:46px;height:46px;border-radius:var(--r);background:linear-gradient(135deg,#E46E14 0%,#c65c0f 100%);display:flex;align-items:center;justify-content:center;transition:transform .2s ease}
.ico svg{width:22px;height:22px;stroke:#fff;fill:none;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
.tag{width:40px;height:40px;border-radius:var(--r);background:linear-gradient(135deg,#E46E14 0%,#c65c0f 100%);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800}

.dark{position:relative;overflow:hidden;background:linear-gradient(165deg,#0E2E4D 0%,#081a2e 55%,#04101c 100%);color:white}
.dark::before{content:"";position:absolute;inset:0;pointer-events:none;background-image:linear-gradient(to right,rgba(255,255,255,.04) 1px,transparent 1px),linear-gradient(to bottom,rgba(255,255,255,.04) 1px,transparent 1px);background-size:44px 44px;-webkit-mask-image:radial-gradient(circle at 50% 0%,#000 0%,transparent 78%);mask-image:radial-gradient(circle at 50% 0%,#000 0%,transparent 78%)}
.dark .container{position:relative;z-index:1}
.dark .section-head p,.dark .card p{color:#a9bcd0}
.dark .card{background:rgba(255,255,255,.04);border-color:rgba(255,255,255,.12);border-top-color:var(--accent)}
.dark .card h3{color:white}
.dark .ico{background:rgba(228,110,20,.16)}

.process{display:grid;gap:0;border-top:1px solid var(--line)}
.step{display:grid;grid-template-columns:64px 1fr;gap:18px;padding:22px 0;border-bottom:1px solid var(--line);min-width:0}
.step b{font-size:18px}
.step p{margin:4px 0 0;color:var(--muted)}
.kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
.kpi{padding:22px;border:1px solid var(--line);border-radius:var(--r);background:var(--soft);min-width:0}
.kpi b{display:block;font-size:18px;margin-bottom:5px}
.kpi span{color:var(--muted);font-size:14px}
.callout{padding:30px;border-radius:var(--r);background:var(--accent-soft);border:1px solid var(--accent-line)}
.callout h3{margin-top:0}
.faq details{border-top:1px solid var(--line);padding:20px 0}
.faq details:last-child{border-bottom:1px solid var(--line)}
.faq summary{cursor:pointer;font-weight:800;list-style:none;display:flex;align-items:center;justify-content:space-between;gap:16px}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:"+";flex:0 0 auto;font-size:24px;font-weight:400;line-height:1;color:var(--accent);transition:transform .25s ease}
.faq details[open] summary::after{transform:rotate(45deg)}
.faq p{color:var(--muted);max-width:820px}
.faq-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:48px;align-items:start}
.cta{padding:68px 0}
.ctabox{background:linear-gradient(165deg,#0E2E4D 0%,#081a2e 100%);color:white;border-radius:var(--r);padding:48px;display:grid;grid-template-columns:1.4fr .8fr;gap:24px;align-items:center}
.ctabox p{color:#a9bcd0;margin-bottom:0}
.cta-actions{display:flex;gap:12px;justify-content:flex-end;flex-wrap:wrap}
.ctabox .btn-secondary{background:transparent;color:white;border-color:#3a5a79}
.ctabox .btn-secondary:hover{border-color:var(--accent)}

@media(max-width:900px){
  .hero-grid,.faq-grid,.grid-3,.grid-2,.kpis,.ctabox{grid-template-columns:1fr}
  .faq-grid .visual{order:-1}
  .hero{padding-top:64px}
  .cta-actions{justify-content:flex-start}
}
</style>

